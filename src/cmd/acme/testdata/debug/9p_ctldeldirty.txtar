-- script --
win
name 1 /a/b
type 1 hi
write 1/ctl "del"
dump
-- stdout --
win 1
error file dirty
row ncol=1
col 0 nw=2
  tag nc=31 dot=0,0
  tag text=/a/b Del Snarf Undo Put | Look ^J
win 1 name=/a/b
  body nc=2 dot=2,2
  body text=hi
  tag nc=25 dot=0,0
  tag text=+Errors Del Snarf | Look ^J
win 2 name=+Errors
  body nc=14 dot=0,14
  body text=/a/b modified

