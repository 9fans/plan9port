-- script --
win
name 1 /a/one
body 1 foo
win
name 2 /a/two
body 2 woo
win
type 3 x
tag 3 Edit X/[ot]/ ,s/o/0/g
b2 3.tag 23 44
b2 1.tag 17 21
dump
-- stdout --
win 1
win 2
win 3
row ncol=1
col 0 nw=3
  tag nc=29 dot=0,0
  tag text=/a/one Del Snarf Redo | Look ^J
win 1 name=/a/one
  body nc=3 dot=1,3
  body text=foo
  tag nc=29 dot=0,0
  tag text=/a/two Del Snarf Redo | Look ^J
win 2 name=/a/two
  body nc=3 dot=1,3
  body text=woo
  tag nc=44 dot=0,0
  tag text= Del Snarf Undo | Look Edit X/[ot]/ ,s/o/0/g
win 3 name=
  body nc=1 dot=1,1
  body text=x
