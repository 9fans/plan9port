Origin requests on a file with a very long single line.
args: -R input

-- script --
startfile 0
origin 0 200 1
origin 0 0 1
exit
-- input --

-- host --
Hversion 2
Hnewname tag=0
Hmovname tag=0 "input"
Hnewname tag=1
Hbindname tag=1
Hcurrent tag=1
Hmovname tag=1 "~~sam~~"
Hcheck0 tag=1
Hack
Hunlock
Hbindname tag=0
Hcurrent tag=0
Hgrow tag=0 p=0 n=401
Hcheck0 tag=0
Hcheck0 tag=0
Hack
Hdata tag=0 p=0 "\n"
Hgrow tag=1 p=0 n=10
Hcheck0 tag=1
Hack
Hdata tag=1 p=0 " +. input\n"
Hsetdot tag=1 p=10 n=10
Hunlock
Horigin tag=0 p=136
Horigin tag=0 p=0
