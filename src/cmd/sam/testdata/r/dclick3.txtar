Double-click on an unmatched open bracket, an unmatched close bracket, nested
brackets, and at end of file.

-- input --
(unmatched
close)here
((nested))
tail
-- proto --
Hversion 2
Hnewname tag=0
Hmovname tag=0 "input"
Tversion 2
Tstartcmdfile
Hnewname tag=1
Hbindname tag=1
Hcurrent tag=1
Hmovname tag=1 "~~sam~~"
Hcheck0 tag=1
Hack
Tack
Hunlock
Tstartfile 0
Hbindname tag=0
Hcurrent tag=0
Hgrow tag=0 p=0 n=38
Hcheck0 tag=0
Hcheck0 tag=0
Hack
Trequest 0 0 38
Hdata tag=0 p=0 "(unmatched\nclose)here\n((nested))\ntail\n"
Tack
Hgrow tag=1 p=0 n=10
Hcheck0 tag=1
Hack
Trequest 1 0 10
Hdata tag=1 p=0 " +. input\n"
Tack
Hsetdot tag=1 p=10 n=10
Hunlock
Tdclick 0 1
Hsetdot tag=0 p=1 n=16
Hunlockfile tag=0
Tdclick 0 16
Hsetdot tag=0 p=1 n=16
Hunlockfile tag=0
Tdclick 0 22
Hsetdot tag=0 p=22 n=33
Hunlockfile tag=0
Tdclick 0 35
Hsetdot tag=0 p=33 n=37
Hunlockfile tag=0
Texit
