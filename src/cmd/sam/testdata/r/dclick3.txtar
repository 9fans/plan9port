Double-click on an unmatched open bracket, an unmatched close bracket, nested
brackets, and at end of file.
args: -R input

-- script --
startfile 0
dclick 0 1
dclick 0 16
dclick 0 22
dclick 0 35
exit
-- input --
(unmatched
close)here
((nested))
tail
-- host --
Hversion 2
Hnewname tag=0
Hmovname tag=0 "input"
Hnewname tag=1
Hbindname tag=1
Hcurrent tag=1
Hmovname tag=1 "~~sam~~"
Hcheck0 tag=1
Hack
Hunlock
Hbindname tag=0
Hcurrent tag=0
Hgrow tag=0 p=0 n=38
Hcheck0 tag=0
Hcheck0 tag=0
Hack
Hdata tag=0 p=0 "(unmatched\nclose)here\n((nested))\ntail\n"
Hgrow tag=1 p=0 n=10
Hcheck0 tag=1
Hack
Hdata tag=1 p=0 " +. input\n"
Hsetdot tag=1 p=10 n=10
Hunlock
Hsetdot tag=0 p=1 n=16
Hunlockfile tag=0
Hsetdot tag=0 p=1 n=16
Hunlockfile tag=0
Hsetdot tag=0 p=22 n=33
Hunlockfile tag=0
Hsetdot tag=0 p=33 n=37
Hunlockfile tag=0
