Double-click matching for every bracketing character: the {} [] () <> pairs and
the self-matching ' " ` quotes, exercised from both the open and close side.

-- input --
{a}
[b]
(c)
<d>
'e'
"f"
`g`
-- proto --
Hversion 2
Hnewname tag=0
Hmovname tag=0 "input"
Tversion 2
Tstartcmdfile
Hnewname tag=1
Hbindname tag=1
Hcurrent tag=1
Hmovname tag=1 "~~sam~~"
Hcheck0 tag=1
Hack
Tack
Hunlock
Tstartfile 0
Hbindname tag=0
Hcurrent tag=0
Hgrow tag=0 p=0 n=28
Hcheck0 tag=0
Hcheck0 tag=0
Hack
Trequest 0 0 28
Hdata tag=0 p=0 "{a}\n[b]\n(c)\n<d>\n'e'\n\"f\"\n`g`\n"
Tack
Hgrow tag=1 p=0 n=10
Hcheck0 tag=1
Hack
Trequest 1 0 10
Hdata tag=1 p=0 " +. input\n"
Tack
Hsetdot tag=1 p=10 n=10
Hunlock
Tdclick 0 1
Hsetdot tag=0 p=1 n=2
Hunlockfile tag=0
Tdclick 0 2
Hsetdot tag=0 p=1 n=2
Hunlockfile tag=0
