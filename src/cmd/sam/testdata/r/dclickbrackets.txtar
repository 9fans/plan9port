Double-click matching for every bracketing character: the {} [] () <> pairs and
the self-matching ' " ` quotes, exercised from both the open and close side.
args: -R input

-- script --
startfile 0
dclick 0 1
dclick 0 2
dclick 0 5
dclick 0 6
dclick 0 9
dclick 0 10
dclick 0 13
dclick 0 14
dclick 0 17
dclick 0 18
dclick 0 21
dclick 0 22
dclick 0 25
dclick 0 26
exit
-- input --
{a}
[b]
(c)
<d>
'e'
"f"
`g`
-- host --
Hversion 2
Hnewname tag=0
Hmovname tag=0 "input"
Hnewname tag=1
Hbindname tag=1
Hcurrent tag=1
Hmovname tag=1 "~~sam~~"
Hcheck0 tag=1
Hack
Hunlock
Hbindname tag=0
Hcurrent tag=0
Hgrow tag=0 p=0 n=28
Hcheck0 tag=0
Hcheck0 tag=0
Hack
Hdata tag=0 p=0 "{a}\n[b]\n(c)\n<d>\n'e'\n\"f\"\n`g`\n"
Hgrow tag=1 p=0 n=10
Hcheck0 tag=1
Hack
Hdata tag=1 p=0 " +. input\n"
Hsetdot tag=1 p=10 n=10
Hunlock
Hsetdot tag=0 p=1 n=2
Hunlockfile tag=0
Hsetdot tag=0 p=1 n=2
Hunlockfile tag=0
Hsetdot tag=0 p=5 n=6
Hunlockfile tag=0
Hsetdot tag=0 p=5 n=6
Hunlockfile tag=0
Hsetdot tag=0 p=9 n=10
Hunlockfile tag=0
Hsetdot tag=0 p=9 n=10
Hunlockfile tag=0
Hsetdot tag=0 p=13 n=14
Hunlockfile tag=0
Hsetdot tag=0 p=13 n=14
Hunlockfile tag=0
Hsetdot tag=0 p=17 n=18
Hunlockfile tag=0
Hsetdot tag=0 p=17 n=18
Hunlockfile tag=0
Hsetdot tag=0 p=21 n=22
Hunlockfile tag=0
Hsetdot tag=0 p=21 n=22
Hunlockfile tag=0
Hsetdot tag=0 p=25 n=26
Hunlockfile tag=0
Hsetdot tag=0 p=25 n=26
Hunlockfile tag=0
