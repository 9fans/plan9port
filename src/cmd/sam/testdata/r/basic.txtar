Open the command window, view a file, print it, then exit.
args: -R input

-- script --
startfile 0
type ,p\n
exit
-- input --
alpha
beta
gamma
-- host --
Hversion 2
Hnewname tag=0
Hmovname tag=0 "input"
Hnewname tag=1
Hbindname tag=1
Hcurrent tag=1
Hmovname tag=1 "~~sam~~"
Hcheck0 tag=1
Hack
Hunlock
Hbindname tag=0
Hcurrent tag=0
Hgrow tag=0 p=0 n=17
Hcheck0 tag=0
Hcheck0 tag=0
Hack
Hdata tag=0 p=0 "alpha\nbeta\ngamma\n"
Hgrow tag=1 p=0 n=10
Hcheck0 tag=1
Hack
Hdata tag=1 p=0 " +. input\n"
Hsetdot tag=1 p=10 n=10
Hunlock
Hgrowdata tag=1 p=13 n=17 "alpha\nbeta\ngamma\n"
Hcheck0 tag=1
Hack
Hsetdot tag=1 p=30 n=30
Hsetdot tag=0 p=0 n=17
Hunlock
