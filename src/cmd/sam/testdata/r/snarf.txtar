Snarf a range, then paste it at end of file.

-- input --
alpha
beta
gamma
-- proto --
Hversion 2
Hnewname tag=0
Hmovname tag=0 "input"
Tversion 2
Tstartcmdfile
Hnewname tag=1
Hbindname tag=1
Hcurrent tag=1
Hmovname tag=1 "~~sam~~"
Hcheck0 tag=1
Hack
Tack
Hunlock
Tstartfile 0
Hbindname tag=0
Hcurrent tag=0
Hgrow tag=0 p=0 n=17
Hcheck0 tag=0
Hcheck0 tag=0
Hack
Trequest 0 0 17
Hdata tag=0 p=0 "alpha\nbeta\ngamma\n"
Tack
Hgrow tag=1 p=0 n=10
Hcheck0 tag=1
Hack
Trequest 1 0 10
Hdata tag=1 p=0 " +. input\n"
Tack
Hsetdot tag=1 p=10 n=10
Hunlock
Tsnarf 0 0 5
Tpaste 0 17
Hdirty tag=0
Hgrowdata tag=0 p=17 n=5 "alpha"
Hcheck0 tag=0
Hack
Tack
Hsetdot tag=0 p=17 n=22
Hunlockfile tag=0
Texit
