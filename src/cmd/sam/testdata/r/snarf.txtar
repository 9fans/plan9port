Snarf a range, then paste it at end of file.
args: -R input

-- script --
startfile 0
snarf 0 0 5
paste 0 17
exit
-- input --
alpha
beta
gamma
-- host --
Hversion 2
Hnewname tag=0
Hmovname tag=0 "input"
Hnewname tag=1
Hbindname tag=1
Hcurrent tag=1
Hmovname tag=1 "~~sam~~"
Hcheck0 tag=1
Hack
Hunlock
Hbindname tag=0
Hcurrent tag=0
Hgrow tag=0 p=0 n=17
Hcheck0 tag=0
Hcheck0 tag=0
Hack
Hdata tag=0 p=0 "alpha\nbeta\ngamma\n"
Hgrow tag=1 p=0 n=10
Hcheck0 tag=1
Hack
Hdata tag=1 p=0 " +. input\n"
Hsetdot tag=1 p=10 n=10
Hunlock
Hdirty tag=0
Hgrowdata tag=0 p=17 n=5 "alpha"
Hcheck0 tag=0
Hack
Hsetdot tag=0 p=17 n=22
Hunlockfile tag=0
