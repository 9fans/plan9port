Double-click on brackets matches the pair; in a word selects the word.
args: -R input

-- script --
startfile 0
dclick 0 0
dclick 0 6
dclick 0 13
exit
-- input --
(foo) [bar]
plain
-- host --
Hversion 2
Hnewname tag=0
Hmovname tag=0 "input"
Hnewname tag=1
Hbindname tag=1
Hcurrent tag=1
Hmovname tag=1 "~~sam~~"
Hcheck0 tag=1
Hack
Hunlock
Hbindname tag=0
Hcurrent tag=0
Hgrow tag=0 p=0 n=18
Hcheck0 tag=0
Hcheck0 tag=0
Hack
Hdata tag=0 p=0 "(foo) [bar]\nplain\n"
Hgrow tag=1 p=0 n=10
Hcheck0 tag=1
Hack
Hdata tag=1 p=0 " +. input\n"
Hsetdot tag=1 p=10 n=10
Hunlock
Hsetdot tag=0 p=0 n=12
Hunlockfile tag=0
Hunlockfile tag=0
Hsetdot tag=0 p=12 n=17
Hunlockfile tag=0
