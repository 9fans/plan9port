Drive the terminal rasp with a big insert, deletes, and a substitution.
args: -R input

-- script --
startfile 0
type 2a\nLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLL\n.\n
type 1d\n
type ,s/e/EEE/g\n
type 1,2d\n
exit
-- input --
alpha
beta
gamma
-- host --
Hversion 2
Hnewname tag=0
Hmovname tag=0 "input"
Hnewname tag=1
Hbindname tag=1
Hcurrent tag=1
Hmovname tag=1 "~~sam~~"
Hcheck0 tag=1
Hack
Hunlock
Hbindname tag=0
Hcurrent tag=0
Hgrow tag=0 p=0 n=17
Hcheck0 tag=0
Hcheck0 tag=0
Hack
Hdata tag=0 p=0 "alpha\nbeta\ngamma\n"
Hgrow tag=1 p=0 n=10
Hcheck0 tag=1
Hack
Hdata tag=1 p=0 " +. input\n"
Hsetdot tag=1 p=10 n=10
Hunlock
Hdirty tag=0
Hgrow tag=0 p=11 n=65
Hcheck0 tag=0
Hack
Hdata tag=0 p=11 "LLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLL\n"
Hsetdot tag=0 p=11 n=76
Hunlock
Hcut tag=0 p=0 n=6
Hcheck0 tag=0
Hack
Hsetdot tag=0 p=0 n=0
Hunlock
Hgrowdata tag=0 p=2 n=3 "EEE"
Hcut tag=0 p=1 n=1
Hcheck0 tag=0
Hack
Hsetdot tag=0 p=0 n=78
Hsetpat "e"
Hunlock
Hcut tag=0 p=0 n=72
Hcheck0 tag=0
Hack
Hsetdot tag=0 p=0 n=0
Hunlock
