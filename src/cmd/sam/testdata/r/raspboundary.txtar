Insert at the boundary between an unknown and a known span (rgrow).
args: -R input

-- script --
noauto
startfile 0
request 0 10 20
type #10a/Z/\n
exit
-- input --
aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
-- host --
Hversion 2
Hnewname tag=0
Hmovname tag=0 "input"
Hnewname tag=1
Hbindname tag=1
Hcurrent tag=1
Hmovname tag=1 "~~sam~~"
Hcheck0 tag=1
Hack
Hunlock
Hbindname tag=0
Hcurrent tag=0
Hgrow tag=0 p=0 n=31
Hcheck0 tag=0
Hcheck0 tag=0
Hack
Hgrow tag=1 p=0 n=10
Hcheck0 tag=1
Hack
Hsetdot tag=1 p=10 n=10
Hunlock
Hdata tag=0 p=10 "aaaaaaaaaaaaaaaaaaaa"
Hdirty tag=0
Hgrowdata tag=0 p=10 n=1 "Z"
Hcheck0 tag=0
Hack
Hsetdot tag=0 p=10 n=11
Hunlock
