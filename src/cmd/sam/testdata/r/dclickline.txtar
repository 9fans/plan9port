Double-click on a newline selects the line (right-match newline, p1<nc).
args: -R input

-- script --
startfile 0
dclick 0 2
exit
-- input --
ab
cd
-- host --
Hversion 2
Hnewname tag=0
Hmovname tag=0 "input"
Hnewname tag=1
Hbindname tag=1
Hcurrent tag=1
Hmovname tag=1 "~~sam~~"
Hcheck0 tag=1
Hack
Hunlock
Hbindname tag=0
Hcurrent tag=0
Hgrow tag=0 p=0 n=6
Hcheck0 tag=0
Hcheck0 tag=0
Hack
Hdata tag=0 p=0 "ab\ncd\n"
Hgrow tag=1 p=0 n=10
Hcheck0 tag=1
Hack
Hdata tag=1 p=0 " +. input\n"
Hsetdot tag=1 p=10 n=10
Hunlock
Hsetdot tag=0 p=0 n=3
Hunlockfile tag=0
