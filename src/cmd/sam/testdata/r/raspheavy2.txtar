Sub-range requests inside known spans (rdata T-subset), mark adjustment on
delete, and dot/mark clamping after deleting past the mark.
args: -R input

-- script --
noauto
startfile 0
request 0 0 20
request 0 5 5
request 0 15 10
type $k\n
type 1,2d\n
type ,d\n
exit
-- input --
alpha
beta
gamma
delta
epsilon
zeta
-- host --
Hversion 2
Hnewname tag=0
Hmovname tag=0 "input"
Hnewname tag=1
Hbindname tag=1
Hcurrent tag=1
Hmovname tag=1 "~~sam~~"
Hcheck0 tag=1
Hack
Hunlock
Hbindname tag=0
Hcurrent tag=0
Hgrow tag=0 p=0 n=36
Hcheck0 tag=0
Hcheck0 tag=0
Hack
Hgrow tag=1 p=0 n=10
Hcheck0 tag=1
Hack
Hsetdot tag=1 p=10 n=10
Hunlock
Hdata tag=0 p=0 "alpha\nbeta\ngamma\ndel"
Hdata tag=0 p=5 ""
Hdata tag=0 p=20 "ta\nep"
Hunlock
Hdirty tag=0
Hcut tag=0 p=0 n=11
Hcheck0 tag=0
Hack
Hunlock
Hcut tag=0 p=0 n=25
Hcheck0 tag=0
Hack
Hunlock
