Append a long line so the rasp sends Hgrow (not inline Hgrowdata).
args: -R input

-- script --
startfile 0
type 1a\nXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX\n.\n
exit
-- input --
alpha
beta
gamma
-- host --
Hversion 2
Hnewname tag=0
Hmovname tag=0 "input"
Hnewname tag=1
Hbindname tag=1
Hcurrent tag=1
Hmovname tag=1 "~~sam~~"
Hcheck0 tag=1
Hack
Hunlock
Hbindname tag=0
Hcurrent tag=0
Hgrow tag=0 p=0 n=17
Hcheck0 tag=0
Hcheck0 tag=0
Hack
Hdata tag=0 p=0 "alpha\nbeta\ngamma\n"
Hgrow tag=1 p=0 n=10
Hcheck0 tag=1
Hack
Hdata tag=1 p=0 " +. input\n"
Hsetdot tag=1 p=10 n=10
Hunlock
Hdirty tag=0
Hgrow tag=0 p=6 n=65
Hcheck0 tag=0
Hack
Hdata tag=0 p=6 "XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX\n"
Hsetdot tag=0 p=6 n=71
Hunlock
