Deleting an unknown span between two known spans merges them (rcut).
args: -R input

-- script --
noauto
startfile 0
request 0 0 10
request 0 20 10
type #10,#20d\n
exit
-- input --
aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
-- host --
Hversion 2
Hnewname tag=0
Hmovname tag=0 "input"
Hnewname tag=1
Hbindname tag=1
Hcurrent tag=1
Hmovname tag=1 "~~sam~~"
Hcheck0 tag=1
Hack
Hunlock
Hbindname tag=0
Hcurrent tag=0
Hgrow tag=0 p=0 n=31
Hcheck0 tag=0
Hcheck0 tag=0
Hack
Hgrow tag=1 p=0 n=10
Hcheck0 tag=1
Hack
Hsetdot tag=1 p=10 n=10
Hunlock
Hdata tag=0 p=0 "aaaaaaaaaa"
Hdata tag=0 p=20 "aaaaaaaaaa"
Hdirty tag=0
Hcut tag=0 p=10 n=10
Hcheck0 tag=0
Hack
Hsetdot tag=0 p=10 n=10
Hunlock
