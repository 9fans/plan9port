A dirty nameless frame dropped on EOF is rescued to $HOME/sam.save as nameless.0.

-- proto --
Hversion 2
Tversion 2
Tstartcmdfile
Hnewname tag=0
Hbindname tag=0
Hcurrent tag=0
Hmovname tag=0 "~~sam~~"
Hcheck0 tag=0
Hack
Tack
Hunlock
Tstartnewfile
Hnewname tag=1
Hbindname tag=1
Hmovname tag=1 ""
Hcurrent tag=1
Hcheck0 tag=1
Hack
Tack
Hgrow tag=0 p=0 n=5
Hcheck0 tag=0
Hack
Trequest 0 0 5
Hdata tag=0 p=0 " +. \n"
Tack
Hsetdot tag=0 p=5 n=5
Ttype 1 0 hello\n
Hdirty tag=1
shutdown
-- sam.save.out --
#!/bin/sh
/plan9/bin/samsave 'nameless.0' $* <<'---nameless.0'
hello

---nameless.0
