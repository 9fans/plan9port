Append at EOF of an unrequested (unknown) region.
args: -R input

-- script --
noauto
startfile 0
type $a/ZZZ/\n
exit
-- input --
alpha
beta
-- host --
Hversion 2
Hnewname tag=0
Hmovname tag=0 "input"
Hnewname tag=1
Hbindname tag=1
Hcurrent tag=1
Hmovname tag=1 "~~sam~~"
Hcheck0 tag=1
Hack
Hunlock
Hbindname tag=0
Hcurrent tag=0
Hgrow tag=0 p=0 n=11
Hcheck0 tag=0
Hcheck0 tag=0
Hack
Hgrow tag=1 p=0 n=10
Hcheck0 tag=1
Hack
Hsetdot tag=1 p=10 n=10
Hunlock
Hdirty tag=0
Hgrow tag=0 p=11 n=3
Hcheck0 tag=0
Hack
Hsetdot tag=0 p=11 n=14
Hunlock
