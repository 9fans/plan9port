A global substitution making hundreds of small edits in terminal-known
regions fills the wire buffer mid-pass (raspflush) and interleaves grow/cut.
args: -R input

-- script --
startfile 0
type ,s/a/aa/g\n
exit
-- input --

-- host --
Hversion 2
Hnewname tag=0
Hmovname tag=0 "input"
Hnewname tag=1
Hbindname tag=1
Hcurrent tag=1
Hmovname tag=1 "~~sam~~"
Hcheck0 tag=1
Hack
Hunlock
Hbindname tag=0
Hcurrent tag=0
Hgrow tag=0 p=0 n=401
Hcheck0 tag=0
Hcheck0 tag=0
Hack
Hdata tag=0 p=0 "\n"
Hgrow tag=1 p=0 n=10
Hcheck0 tag=1
Hack
Hdata tag=1 p=0 " +. input\n"
Hsetdot tag=1 p=10 n=10
Hunlock
Hdirty tag=0
Hgrow tag=0 p=400 n=800
Hcut tag=0 p=0 n=400
Hcheck0 tag=0
Hack
Hdata tag=0 p=400 ""
Hdata tag=0 p=801 ""
Hsetdot tag=0 p=0 n=801
Hsetpat "a"
Hunlock
