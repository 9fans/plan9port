Pasting into the command window before cmdpt shifts cmdpt (raspinsert 150).
args: -R input

-- script --
startfile 0
type 1p\n
snarf 0 0 5
paste 1 0
exit
-- input --
hello world
-- host --
Hversion 2
Hnewname tag=0
Hmovname tag=0 "input"
Hnewname tag=1
Hbindname tag=1
Hcurrent tag=1
Hmovname tag=1 "~~sam~~"
Hcheck0 tag=1
Hack
Hunlock
Hbindname tag=0
Hcurrent tag=0
Hgrow tag=0 p=0 n=12
Hcheck0 tag=0
Hcheck0 tag=0
Hack
Hdata tag=0 p=0 "hello world\n"
Hgrow tag=1 p=0 n=10
Hcheck0 tag=1
Hack
Hdata tag=1 p=0 " +. input\n"
Hsetdot tag=1 p=10 n=10
Hunlock
Hgrowdata tag=1 p=13 n=12 "hello world\n"
Hcheck0 tag=1
Hack
Hsetdot tag=1 p=25 n=25
Hsetdot tag=0 p=0 n=12
Hunlock
Hgrowdata tag=1 p=0 n=5 "hello"
Hcheck0 tag=1
Hack
Hsetdot tag=1 p=0 n=5
Hunlockfile tag=1
