Double-click just after an open bracket, on a quote, and at line end; a "
address against a file that has a rasp shows the + flag.

-- input --
(foo)
'q' word
abc
-- proto --
Hversion 2
Hnewname tag=0
Hmovname tag=0 "input"
Tversion 2
Tstartcmdfile
Hnewname tag=1
Hbindname tag=1
Hcurrent tag=1
Hmovname tag=1 "~~sam~~"
Hcheck0 tag=1
Hack
Tack
Hunlock
Tstartfile 0
Hbindname tag=0
Hcurrent tag=0
Hgrow tag=0 p=0 n=19
Hcheck0 tag=0
Hcheck0 tag=0
Hack
Trequest 0 0 19
Hdata tag=0 p=0 "(foo)\n'q' word\nabc\n"
Tack
Hgrow tag=1 p=0 n=10
Hcheck0 tag=1
Hack
Trequest 1 0 10
Hdata tag=1 p=0 " +. input\n"
Tack
Hsetdot tag=1 p=10 n=10
Hunlock
Tdclick 0 1
Hsetdot tag=0 p=1 n=4
Hunlockfile tag=0
Tdclick 0 6
Hsetdot tag=0 p=6 n=15
Hunlockfile tag=0
Tdclick 0 12
Hsetdot tag=0 p=10 n=14
Hunlockfile tag=0
cmd "input"p
Torigin 0 0 0
Horigin tag=0 p=0
Texit
