Double-click just after an open bracket, on a quote, and at line end; a "
address against a file that has a rasp shows the + flag.
args: -R input

-- script --
startfile 0
dclick 0 1
dclick 0 6
dclick 0 12
type "input"p
origin 0 0 0
exit
-- input --
(foo)
'q' word
abc
-- host --
Hversion 2
Hnewname tag=0
Hmovname tag=0 "input"
Hnewname tag=1
Hbindname tag=1
Hcurrent tag=1
Hmovname tag=1 "~~sam~~"
Hcheck0 tag=1
Hack
Hunlock
Hbindname tag=0
Hcurrent tag=0
Hgrow tag=0 p=0 n=19
Hcheck0 tag=0
Hcheck0 tag=0
Hack
Hdata tag=0 p=0 "(foo)\n'q' word\nabc\n"
Hgrow tag=1 p=0 n=10
Hcheck0 tag=1
Hack
Hdata tag=1 p=0 " +. input\n"
Hsetdot tag=1 p=10 n=10
Hunlock
Hsetdot tag=0 p=1 n=4
Hunlockfile tag=0
Hsetdot tag=0 p=6 n=15
Hunlockfile tag=0
Hsetdot tag=0 p=10 n=14
Hunlockfile tag=0
Horigin tag=0 p=0
