Double-click on an unmatched close bracket scans to start (clickmatch dir<0 start).
args: -R input

-- script --
startfile 0
dclick 0 3
exit
-- input --
abc)
-- host --
Hversion 2
Hnewname tag=0
Hmovname tag=0 "input"
Hnewname tag=1
Hbindname tag=1
Hcurrent tag=1
Hmovname tag=1 "~~sam~~"
Hcheck0 tag=1
Hack
Hunlock
Hbindname tag=0
Hcurrent tag=0
Hgrow tag=0 p=0 n=5
Hcheck0 tag=0
Hcheck0 tag=0
Hack
Hdata tag=0 p=0 "abc)\n"
Hgrow tag=1 p=0 n=10
Hcheck0 tag=1
Hack
Hdata tag=1 p=0 " +. input\n"
Hsetdot tag=1 p=10 n=10
Hunlock
Hunlockfile tag=0
