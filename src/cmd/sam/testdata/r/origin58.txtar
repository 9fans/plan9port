Origin request deep in a multi-line file scans back over newlines (lookorigin nl>0).
args: -R input

-- script --
startfile 0
origin 0 15 2
exit
-- input --
aaaa
bbbb
cccc
dddd
eeee
-- host --
Hversion 2
Hnewname tag=0
Hmovname tag=0 "input"
Hnewname tag=1
Hbindname tag=1
Hcurrent tag=1
Hmovname tag=1 "~~sam~~"
Hcheck0 tag=1
Hack
Hunlock
Hbindname tag=0
Hcurrent tag=0
Hgrow tag=0 p=0 n=25
Hcheck0 tag=0
Hcheck0 tag=0
Hack
Hdata tag=0 p=0 "aaaa\nbbbb\ncccc\ndddd\neeee\n"
Hgrow tag=1 p=0 n=10
Hcheck0 tag=1
Hack
Hdata tag=1 p=0 " +. input\n"
Hsetdot tag=1 p=10 n=10
Hunlock
Horigin tag=0 p=10
