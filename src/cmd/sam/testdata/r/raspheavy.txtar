Partial requests then boundary-spanning deletes, a middle insert, and a full
delete (which clamps dot/mark) to exercise rcut/rgrow/rdata and raspdone.
args: -R input

-- script --
noauto
startfile 0
request 0 5 10
request 0 25 8
request 0 3 4
type 2,4d\n
type 1a/INS/\n
type ,d\n
type 1a/back/\n
exit
-- input --
alpha
beta
gamma
delta
epsilon
zeta
eta
-- host --
Hversion 2
Hnewname tag=0
Hmovname tag=0 "input"
Hnewname tag=1
Hbindname tag=1
Hcurrent tag=1
Hmovname tag=1 "~~sam~~"
Hcheck0 tag=1
Hack
Hunlock
Hbindname tag=0
Hcurrent tag=0
Hgrow tag=0 p=0 n=40
Hcheck0 tag=0
Hcheck0 tag=0
Hack
Hgrow tag=1 p=0 n=10
Hcheck0 tag=1
Hack
Hsetdot tag=1 p=10 n=10
Hunlock
Hdata tag=0 p=5 "\nbeta\ngamm"
Hdata tag=0 p=25 "silon\nze"
Hdata tag=0 p=3 "ha"
Hdirty tag=0
Hcut tag=0 p=6 n=17
Hcheck0 tag=0
Hack
Hsetdot tag=0 p=6 n=6
Hunlock
Hgrow tag=0 p=6 n=3
Hcheck0 tag=0
Hack
Hsetdot tag=0 p=6 n=9
Hunlock
Hcut tag=0 p=0 n=26
Hcheck0 tag=0
Hack
Hsetdot tag=0 p=0 n=0
Hunlock
Hgrow tag=0 p=0 n=4
Hcheck0 tag=0
Hack
Hsetdot tag=0 p=0 n=4
Hunlock
