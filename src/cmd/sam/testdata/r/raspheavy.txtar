Partial requests then boundary-spanning deletes, a middle insert, and a full
delete (which clamps dot/mark) to exercise rcut/rgrow/rdata and raspdone.

-- input --
alpha
beta
gamma
delta
epsilon
zeta
eta
-- proto --
Hversion 2
Hnewname tag=0
Hmovname tag=0 "input"
Tversion 2
Tstartcmdfile
Hnewname tag=1
Hbindname tag=1
Hcurrent tag=1
Hmovname tag=1 "~~sam~~"
Hcheck0 tag=1
Hack
Tack
Hunlock
Tstartfile 0
Hbindname tag=0
Hcurrent tag=0
Hgrow tag=0 p=0 n=40
Hcheck0 tag=0
Hcheck0 tag=0
Hack
Tack
Hgrow tag=1 p=0 n=10
Hcheck0 tag=1
Hack
Tack
Hsetdot tag=1 p=10 n=10
Hunlock
Trequest 0 5 10
Hdata tag=0 p=5 "\nbeta\ngamm"
Trequest 0 25 8
Hdata tag=0 p=25 "silon\nze"
Trequest 0 3 4
Hdata tag=0 p=3 "ha"
cmd 2,4d\n
Hdirty tag=0
Hcut tag=0 p=6 n=17
Hcheck0 tag=0
Hack
Tack
Hsetdot tag=0 p=6 n=6
Hunlock
cmd 1a/INS/\n
Hgrow tag=0 p=6 n=3
Hcheck0 tag=0
Hack
Tack
Hsetdot tag=0 p=6 n=9
Hunlock
cmd ,d\n
Hcut tag=0 p=0 n=26
Hcheck0 tag=0
Hack
Tack
Hsetdot tag=0 p=0 n=0
Hunlock
cmd 1a/back/\n
Hgrow tag=0 p=0 n=4
Hcheck0 tag=0
Hack
Tack
Hsetdot tag=0 p=0 n=4
