A command that switches the current file makes the host send Hcurrent.
args: -R a b

-- script --
startfile 0
type b b\n
exit
-- b --
three
-- a --
one
two
-- host --
Hversion 2
Hnewname tag=0
Hmovname tag=0 "a"
Hnewname tag=1
Hmovname tag=1 "b"
Hnewname tag=2
Hbindname tag=2
Hcurrent tag=2
Hmovname tag=2 "~~sam~~"
Hcheck0 tag=2
Hack
Hunlock
Hbindname tag=0
Hcurrent tag=0
Hgrow tag=0 p=0 n=8
Hcheck0 tag=0
Hcheck0 tag=0
Hack
Hdata tag=0 p=0 "one\ntwo\n"
Hgrow tag=2 p=0 n=6
Hcheck0 tag=2
Hack
Hdata tag=2 p=0 " +. a\n"
Hsetdot tag=2 p=6 n=6
Hunlock
Hgrowdata tag=2 p=10 n=6 " -. b\n"
Hcheck0 tag=2
Hack
Hsetdot tag=2 p=16 n=16
Hcurrent tag=1
Hunlock
