Partial requests build a multi-span rasp; edits then split, chop, and merge
those spans (exercising rcut/rgrow/rdata).
args: -R input

-- script --
noauto
startfile 0
request 0 0 6
request 0 10 8
request 0 20 5
type 1a/X/\n
type 3d\n
type ,s/a/AAAA/g\n
type 2,4d\n
exit
-- input --
alpha
beta
gamma
delta
epsilon
zeta
-- host --
Hversion 2
Hnewname tag=0
Hmovname tag=0 "input"
Hnewname tag=1
Hbindname tag=1
Hcurrent tag=1
Hmovname tag=1 "~~sam~~"
Hcheck0 tag=1
Hack
Hunlock
Hbindname tag=0
Hcurrent tag=0
Hgrow tag=0 p=0 n=36
Hcheck0 tag=0
Hcheck0 tag=0
Hack
Hgrow tag=1 p=0 n=10
Hcheck0 tag=1
Hack
Hsetdot tag=1 p=10 n=10
Hunlock
Hdata tag=0 p=0 "alpha\n"
Hdata tag=0 p=10 "\ngamma\nd"
Hdata tag=0 p=20 "ta\nep"
Hdirty tag=0
Hgrow tag=0 p=6 n=1
Hcheck0 tag=0
Hack
Hsetdot tag=0 p=6 n=7
Hunlock
Hcut tag=0 p=12 n=6
Hcheck0 tag=0
Hack
Hsetdot tag=0 p=12 n=12
Hunlock
Hgrow tag=0 p=30 n=45
Hcut tag=0 p=0 n=30
Hcheck0 tag=0
Hack
Hsetdot tag=0 p=0 n=46
Hsetpat "a"
Hunlock
Hcut tag=0 p=12 n=26
Hcheck0 tag=0
Hack
Hsetdot tag=0 p=12 n=12
Hunlock
