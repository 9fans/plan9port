Partial requests build a multi-span rasp; edits then split, chop, and merge
those spans (exercising rcut/rgrow/rdata).

-- input --
alpha
beta
gamma
delta
epsilon
zeta
-- proto --
Hversion 2
Hnewname tag=0
Hmovname tag=0 "input"
Tversion 2
Tstartcmdfile
Hnewname tag=1
Hbindname tag=1
Hcurrent tag=1
Hmovname tag=1 "~~sam~~"
Hcheck0 tag=1
Hack
Tack
Hunlock
Tstartfile 0
Hbindname tag=0
Hcurrent tag=0
Hgrow tag=0 p=0 n=36
Hcheck0 tag=0
Hcheck0 tag=0
Hack
Tack
Hgrow tag=1 p=0 n=10
Hcheck0 tag=1
Hack
Tack
Hsetdot tag=1 p=10 n=10
Hunlock
Trequest 0 0 6
Hdata tag=0 p=0 "alpha\n"
Trequest 0 10 8
Hdata tag=0 p=10 "\ngamma\nd"
Trequest 0 20 5
Hdata tag=0 p=20 "ta\nep"
cmd 1a/X/\n
Hdirty tag=0
Hgrow tag=0 p=6 n=1
Hcheck0 tag=0
Hack
Tack
Hsetdot tag=0 p=6 n=7
Hunlock
cmd 3d\n
Hcut tag=0 p=12 n=6
Hcheck0 tag=0
Hack
Tack
Hsetdot tag=0 p=12 n=12
Hunlock
cmd ,s/a/AAAA/g\n
Hgrow tag=0 p=30 n=45
Hcut tag=0 p=0 n=30
Hcheck0 tag=0
Hack
Tack
Hsetdot tag=0 p=0 n=46
Hsetpat "a"
Hunlock
cmd 2,4d\n
Hcut tag=0 p=12 n=26
Hcheck0 tag=0
Hack
Tack
Hsetdot tag=0 p=12 n=12
Hunlock
Texit
