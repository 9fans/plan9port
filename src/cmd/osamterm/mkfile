<$PLAN9/src/mkhdr

TARG=osamterm
OFILES=\
	main.$O\
	icons.$O\
	menu.$O\
	mesg.$O\
	rasp.$O\
	scroll.$O\
	flayer.$O\
	io.$O\
	plan9.$O\

HFILES=\
	samterm.h\
	flayer.h\
	../osam/sam.h\
	../osam/mesg.h\
	$PLAN9/include/frame.h\
	$PLAN9/include/draw.h\

CFLAGS=$CFLAGS -I../osam

<$PLAN9/src/mkone

# Coverage-enabled samterm for testing (uncover -x).
COVCFLAGS=-fprofile-instr-generate -fcoverage-mapping
COVLDFLAGS=-fprofile-instr-generate
COVOFILES=${OFILES:%.$O=%.cover.$O}

$O.$TARG.cover:	$COVOFILES
	$LD -o $O.$TARG.cover $COVLDFLAGS $COVOFILES $LDFLAGS

%.cover.$O:	%.c $HFILES
	$CC $CFLAGS $COVCFLAGS -o $stem.cover.$O $stem.c

CLEANFILES=$CLEANFILES $COVOFILES $O.osamterm.cover
