<$PLAN9/src/mkhdr

LIB=libframe.a

OFILES=\
	frbox.$O\
	frdelete.$O\
	frdraw.$O\
	frinit.$O\
	frinsert.$O\
	frptofchar.$O\
	frselect.$O\
	frstr.$O\
	frutil.$O\

HFILES=\
	$PLAN9/include/frame.h\
	$PLAN9/include/draw.h\

<$PLAN9/src/mksyslib

COVCFLAGS=-fprofile-instr-generate -fcoverage-mapping
COVLDFLAGS=-fprofile-instr-generate
COVOFILES=frametest.cover.$O ${OFILES:%.$O=%.cover.$O}

frametest.cover: $COVOFILES
	$LD -o frametest.cover $COVLDFLAGS $COVOFILES $LDFLAGS

frametest.cover.$O:	frametest.c
	$CC $CFLAGS $COVCFLAGS -o frametest.cover.$O frametest.c

%.cover.$O:	%.c
	$CC $CFLAGS $COVCFLAGS -o $stem.cover.$O $stem.c

CLEANFILES=$CLEANFILES frametest.cover $COVOFILES
