Differential frame test delinsel (Go port vs C libframe).
-- script --
init 300 100
insert 0 "aa\tbb\tcc dd"
select 10,10,1 250,10,1 250,10,0
delete 0 2
dump
-- output --
frame nbox=4 nchars=9 nlines=1 maxlines=6 lastlinefull=0 modified=1 p0=0 p1=9
  r=(0 0)(300 90) entire=(0 0)(300 100) maxtab=72 fh=15
box[0] brk wid=72 minwid=4 bc=9
box[1] run wid=18 nrune=2 "bb"
box[2] brk wid=54 minwid=4 bc=9
box[3] run wid=38 nrune=5 "cc dd"
