Differential frame test delmid2 (Go port vs C libframe).
-- script --
init 200 200
insert 0 "aaa\nbbb\nccc\nddd\neee"
delete 3 7
dump
-- output --
frame nbox=7 nchars=15 nlines=4 maxlines=13 lastlinefull=0 modified=1 p0=15 p1=15
  r=(0 0)(200 195) entire=(0 0)(200 200) maxtab=72 fh=15
box[0] run wid=24 nrune=3 "aaa"
box[1] brk wid=5000 minwid=0 bc=10
box[2] run wid=24 nrune=3 "ccc"
box[3] brk wid=5000 minwid=0 bc=10
box[4] run wid=27 nrune=3 "ddd"
box[5] brk wid=5000 minwid=0 bc=10
box[6] run wid=24 nrune=3 "eee"
