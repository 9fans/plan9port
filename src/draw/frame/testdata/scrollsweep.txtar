Differential frame test scrollsweep (Go port vs C libframe).
-- script --
init 200 100
insert 0 "hello world bye now"
selscroll 50,10,1 130,10,1 30,-20,1
dump
-- output --
frame nbox=1 nchars=19 nlines=1 maxlines=6 lastlinefull=0 modified=0 p0=0 p1=7
  r=(0 0)(200 90) entire=(0 0)(200 100) maxtab=72 fh=15
box[0] run wid=141 nrune=19 "hello world bye now"
