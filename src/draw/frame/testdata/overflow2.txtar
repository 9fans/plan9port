Differential frame test overflow2 (Go port vs C libframe).
-- script --
init 120 80
insert 0 "aaaa\nbbbb\ncccc\ndddd\neeee\nffff\ngggg"
dump
-- output --
frame nbox=10 nchars=25 nlines=5 maxlines=5 lastlinefull=1 modified=1 p0=25 p1=25
  r=(0 0)(120 75) entire=(0 0)(120 80) maxtab=72 fh=15
box[0] run wid=32 nrune=4 "aaaa"
box[1] brk wid=5000 minwid=0 bc=10
box[2] run wid=36 nrune=4 "bbbb"
box[3] brk wid=5000 minwid=0 bc=10
box[4] run wid=32 nrune=4 "cccc"
box[5] brk wid=5000 minwid=0 bc=10
box[6] run wid=36 nrune=4 "dddd"
box[7] brk wid=5000 minwid=0 bc=10
box[8] run wid=32 nrune=4 "eeee"
box[9] brk wid=5000 minwid=0 bc=10
