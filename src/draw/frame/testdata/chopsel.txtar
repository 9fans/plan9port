Insert lines into a full frame with a selection reaching the end, so
chop drops NumChars below P0/P1 and they clamp.
-- script --
init 200 80
insert 0 "aa\nbb\ncc\ndd"
select 5,55,1 50,55,1 50,55,0
insert 3 "X\nY\nZ\nW\n"
dump
-- output --
frame nbox=10 nchars=11 nlines=5 maxlines=5 lastlinefull=1 modified=1 p0=11 p1=11
  r=(0 0)(200 75) entire=(0 0)(200 80) maxtab=72 fh=15
box[0] run wid=16 nrune=2 "aa"
box[1] brk wid=5000 minwid=0 bc=10
box[2] run wid=9 nrune=1 "X"
box[3] brk wid=5000 minwid=0 bc=10
box[4] run wid=9 nrune=1 "Y"
box[5] brk wid=5000 minwid=0 bc=10
box[6] run wid=9 nrune=1 "Z"
box[7] brk wid=5000 minwid=0 bc=10
box[8] run wid=13 nrune=1 "W"
box[9] brk wid=5000 minwid=0 bc=10
