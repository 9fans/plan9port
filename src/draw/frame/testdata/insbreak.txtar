Differential frame test insbreak (Go port vs C libframe).
-- script --
init 300 200
insert 0 "aa\tbb\ncc\tdd"
insert 0 "PRE"
dump
-- output --
frame nbox=7 nchars=14 nlines=2 maxlines=13 lastlinefull=0 modified=1 p0=14 p1=14
  r=(0 0)(300 195) entire=(0 0)(300 200) maxtab=72 fh=15
box[0] run wid=41 nrune=5 "PREaa"
box[1] brk wid=31 minwid=4 bc=9
box[2] run wid=18 nrune=2 "bb"
box[3] brk wid=5000 minwid=0 bc=10
box[4] run wid=16 nrune=2 "cc"
box[5] brk wid=56 minwid=4 bc=9
box[6] run wid=18 nrune=2 "dd"
