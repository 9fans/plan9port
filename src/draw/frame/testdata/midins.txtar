Differential frame test midins (Go port vs C libframe).
-- script --
init 200 100
insert 0 "helloworld"
insert 5 "_MID_"
dump
-- output --
frame nbox=1 nchars=15 nlines=1 maxlines=6 lastlinefull=0 modified=1 p0=15 p1=15
  r=(0 0)(200 90) entire=(0 0)(200 100) maxtab=72 fh=15
box[0] run wid=121 nrune=15 "hello_MID_world"
