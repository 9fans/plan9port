Differential frame test newlines (Go port vs C libframe).
-- script --
init 200 200
insert 0 "one\ntwo\nthree\nfour"
dump
-- output --
frame nbox=7 nchars=18 nlines=4 maxlines=13 lastlinefull=0 modified=1 p0=18 p1=18
  r=(0 0)(200 195) entire=(0 0)(200 200) maxtab=72 fh=15
box[0] run wid=26 nrune=3 "one"
box[1] brk wid=5000 minwid=0 bc=10
box[2] run wid=26 nrune=3 "two"
box[3] brk wid=5000 minwid=0 bc=10
box[4] run wid=36 nrune=5 "three"
box[5] brk wid=5000 minwid=0 bc=10
box[6] run wid=29 nrune=4 "four"
