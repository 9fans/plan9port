Differential frame test insselnl (Go port vs C libframe).
-- script --
init 200 200
insert 0 "ab\ncd\nef\ngh"
select 5,10,1 50,40,1 50,40,0
insert 0 "WWWW"
dump
-- output --
frame nbox=7 nchars=15 nlines=4 maxlines=13 lastlinefull=0 modified=1 p0=4 p1=12
  r=(0 0)(200 195) entire=(0 0)(200 200) maxtab=72 fh=15
box[0] run wid=69 nrune=6 "WWWWab"
box[1] brk wid=5000 minwid=0 bc=10
box[2] run wid=17 nrune=2 "cd"
box[3] brk wid=5000 minwid=0 bc=10
box[4] run wid=13 nrune=2 "ef"
box[5] brk wid=5000 minwid=0 bc=10
box[6] run wid=18 nrune=2 "gh"
