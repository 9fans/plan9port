Differential frame test selmline (Go port vs C libframe).
-- script --
init 200 200
insert 0 "aaaa\nbbbb\ncccc"
select 10,10,1 60,40,1 60,40,0
dump
-- output --
frame nbox=5 nchars=14 nlines=3 maxlines=13 lastlinefull=0 modified=0 p0=1 p1=14
  r=(0 0)(200 195) entire=(0 0)(200 200) maxtab=72 fh=15
box[0] run wid=32 nrune=4 "aaaa"
box[1] brk wid=5000 minwid=0 bc=10
box[2] run wid=36 nrune=4 "bbbb"
box[3] brk wid=5000 minwid=0 bc=10
box[4] run wid=32 nrune=4 "cccc"
