Differential frame test ovffront2 (Go port vs C libframe).
-- script --
init 200 130
insert 0 "one\ntwo\nthree\nfour"
insert 0 "zero\n"
dump
-- output --
frame nbox=9 nchars=23 nlines=5 maxlines=8 lastlinefull=0 modified=1 p0=23 p1=23
  r=(0 0)(200 120) entire=(0 0)(200 130) maxtab=72 fh=15
box[0] run wid=31 nrune=4 "zero"
box[1] brk wid=5000 minwid=0 bc=10
box[2] run wid=26 nrune=3 "one"
box[3] brk wid=5000 minwid=0 bc=10
box[4] run wid=26 nrune=3 "two"
box[5] brk wid=5000 minwid=0 bc=10
box[6] run wid=36 nrune=5 "three"
box[7] brk wid=5000 minwid=0 bc=10
box[8] run wid=29 nrune=4 "four"
