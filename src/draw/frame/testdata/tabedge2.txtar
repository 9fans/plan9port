Differential frame test tabedge2 (Go port vs C libframe).
-- script --
init 50 100
insert 0 "\t\t\t\tQ"
dump
-- output --
frame nbox=5 nchars=5 nlines=1 maxlines=6 lastlinefull=0 modified=1 p0=5 p1=5
  r=(0 0)(50 90) entire=(0 0)(50 100) maxtab=72 fh=15
box[0] brk wid=4 minwid=4 bc=9
box[1] brk wid=4 minwid=4 bc=9
box[2] brk wid=4 minwid=4 bc=9
box[3] brk wid=4 minwid=4 bc=9
box[4] run wid=11 nrune=1 "Q"
