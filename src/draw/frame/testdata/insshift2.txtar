Differential frame test insshift2 (Go port vs C libframe).
-- script --
init 200 100
insert 0 "aa\tbb cc dd ee"
insert 0 "WWWW"
dump
-- output --
frame nbox=3 nchars=18 nlines=1 maxlines=6 lastlinefull=0 modified=1 p0=18 p1=18
  r=(0 0)(200 90) entire=(0 0)(200 100) maxtab=72 fh=15
box[0] run wid=68 nrune=6 "WWWWaa"
box[1] brk wid=4 minwid=4 bc=9
box[2] run wid=80 nrune=11 "bb cc dd ee"
