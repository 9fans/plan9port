Differential frame test tabs (Go port vs C libframe).
-- script --
init 300 100
insert 0 "a\tbb\tccc\tdddd\teeeee"
dump
-- output --
frame nbox=10 nchars=19 nlines=2 maxlines=6 lastlinefull=0 modified=1 p0=19 p1=19
  r=(0 0)(300 90) entire=(0 0)(300 100) maxtab=72 fh=15
box[0] run wid=8 nrune=1 "a"
box[1] brk wid=64 minwid=4 bc=9
box[2] run wid=18 nrune=2 "bb"
box[3] brk wid=54 minwid=4 bc=9
box[4] run wid=24 nrune=3 "ccc"
box[5] brk wid=48 minwid=4 bc=9
box[6] run wid=36 nrune=4 "dddd"
box[7] brk wid=36 minwid=4 bc=9
box[8] run wid=8 nrune=1 "e"
box[9] run wid=32 nrune=4 "eeee"
