Insert inside a selection spanning a tab, mid-text.
-- script --
init 300 100
insert 0 "aa bb\tcc dd ee"
select 0,10,1 250,10,1 250,10,0
insert 3 "ZZZZ"
dump
-- output --
frame nbox=3 nchars=18 nlines=1 maxlines=6 lastlinefull=0 modified=1 p0=0 p1=18
  r=(0 0)(300 90) entire=(0 0)(300 100) maxtab=72 fh=15
box[0] run wid=74 nrune=9 "aa ZZZZbb"
box[1] brk wid=70 minwid=4 bc=9
box[2] run wid=58 nrune=8 "cc dd ee"
