Differential frame test tabedge (Go port vs C libframe).
-- script --
init 70 100
insert 0 "abcd\tx\ty\tz"
dump
-- output --
frame nbox=7 nchars=10 nlines=2 maxlines=6 lastlinefull=0 modified=1 p0=10 p1=10
  r=(0 0)(70 90) entire=(0 0)(70 100) maxtab=72 fh=15
box[0] run wid=34 nrune=4 "abcd"
box[1] brk wid=4 minwid=4 bc=9
box[2] run wid=9 nrune=1 "x"
box[3] brk wid=4 minwid=4 bc=9
box[4] run wid=8 nrune=1 "y"
box[5] brk wid=4 minwid=4 bc=9
box[6] run wid=8 nrune=1 "z"
