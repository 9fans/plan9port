Differential frame test delseltab (Go port vs C libframe).
-- script --
init 300 100
insert 0 "ab\tcd\tef ghij"
select 130,10,1 230,10,1 230,10,0
delete 1 4
dump
-- output --
frame nbox=3 nchars=10 nlines=1 maxlines=6 lastlinefull=0 modified=1 p0=2 p1=10
  r=(0 0)(300 90) entire=(0 0)(300 100) maxtab=72 fh=15
box[0] run wid=17 nrune=2 "ad"
box[1] brk wid=55 minwid=4 bc=9
box[2] run wid=44 nrune=7 "ef ghij"
