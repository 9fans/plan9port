Delete a middle multi-line range in a completely full frame so the
end-of-text point lands at the bottom and the q2 clamp fires.
-- script --
init 200 80
insert 0 "aaaa\nbbbb\ncccc\ndddd\neeee\nffff"
delete 5 10
dump
-- output --
frame nbox=8 nchars=20 nlines=4 maxlines=5 lastlinefull=0 modified=1 p0=20 p1=20
  r=(0 0)(200 75) entire=(0 0)(200 80) maxtab=72 fh=15
box[0] run wid=32 nrune=4 "aaaa"
box[1] brk wid=5000 minwid=0 bc=10
box[2] run wid=32 nrune=4 "cccc"
box[3] brk wid=5000 minwid=0 bc=10
box[4] run wid=36 nrune=4 "dddd"
box[5] brk wid=5000 minwid=0 bc=10
box[6] run wid=32 nrune=4 "eeee"
box[7] brk wid=5000 minwid=0 bc=10
