Another chop() case: insert four "lines into a five-line frame."
-- script --
init 200 95
insert 0 "one\ntwo\nthree\nfour\nfive"
insert 4 "A\nB\nC\nD\n"
dump
-- output --
frame nbox=12 nchars=16 nlines=6 maxlines=6 lastlinefull=1 modified=1 p0=16 p1=16
  r=(0 0)(200 90) entire=(0 0)(200 95) maxtab=72 fh=15
box[0] run wid=26 nrune=3 "one"
box[1] brk wid=5000 minwid=0 bc=10
box[2] run wid=10 nrune=1 "A"
box[3] brk wid=5000 minwid=0 bc=10
box[4] run wid=9 nrune=1 "B"
box[5] brk wid=5000 minwid=0 bc=10
box[6] run wid=10 nrune=1 "C"
box[7] brk wid=5000 minwid=0 bc=10
box[8] run wid=11 nrune=1 "D"
box[9] brk wid=5000 minwid=0 bc=10
box[10] run wid=26 nrune=3 "two"
box[11] brk wid=5000 minwid=0 bc=10
