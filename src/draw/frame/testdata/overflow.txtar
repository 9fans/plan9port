Differential frame test overflow (Go port vs C libframe).
-- script --
init 120 80
insert 0 "one two three four five six seven eight nine ten"
dump
-- output --
frame nbox=3 nchars=48 nlines=3 maxlines=5 lastlinefull=0 modified=1 p0=48 p1=48
  r=(0 0)(120 75) entire=(0 0)(120 80) maxtab=72 fh=15
box[0] run wid=114 nrune=16 "one two three fo"
box[1] run wid=116 nrune=18 "ur five six seven "
box[2] run wid=95 nrune=14 "eight nine ten"
