Differential frame test queries2 (Go port vs C libframe).
-- script --
init 200 200
insert 0 "aa\nbb\ncc"
charofpt 300 10
charofpt 10 50
charofpt 10 195
ptofchar 99
dump
-- output --
charofpt 300 10 = 2
charofpt 10 50 = 8
charofpt 10 195 = 8
ptofchar 99 = (16 30)
frame nbox=5 nchars=8 nlines=3 maxlines=13 lastlinefull=0 modified=1 p0=8 p1=8
  r=(0 0)(200 195) entire=(0 0)(200 200) maxtab=72 fh=15
box[0] run wid=16 nrune=2 "aa"
box[1] brk wid=5000 minwid=0 bc=10
box[2] run wid=18 nrune=2 "bb"
box[3] brk wid=5000 minwid=0 bc=10
box[4] run wid=16 nrune=2 "cc"
