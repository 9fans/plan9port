Differential frame test ovfwrap2 (Go port vs C libframe).
-- script --
init 36 100
insert 0 "lli"
insert 2 "WW"
dump
-- output --
frame nbox=2 nchars=5 nlines=2 maxlines=6 lastlinefull=0 modified=1 p0=5 p1=5
  r=(0 0)(36 90) entire=(0 0)(36 100) maxtab=72 fh=15
box[0] run wid=34 nrune=4 "llWW"
box[1] run wid=4 nrune=1 "i"
