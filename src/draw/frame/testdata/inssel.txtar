Differential frame test inssel (Go port vs C libframe).
-- script --
init 200 100
insert 0 "hello world"
select 30,10,1 100,10,1 100,10,0
insert 5 "_"
dump
-- output --
frame nbox=1 nchars=12 nlines=1 maxlines=6 lastlinefull=0 modified=1 p0=4 p1=12
  r=(0 0)(200 90) entire=(0 0)(200 100) maxtab=72 fh=15
box[0] run wid=87 nrune=12 "hello_ world"
