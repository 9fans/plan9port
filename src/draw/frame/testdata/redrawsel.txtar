Differential frame test redrawsel (Go port vs C libframe).
-- script --
init 300 100
insert 0 "aa\tbb\tcc\tdd"
select 150,10,1 250,10,1 250,10,0
redraw
dump
-- output --
frame nbox=7 nchars=11 nlines=1 maxlines=6 lastlinefull=0 modified=0 p0=6 p1=11
  r=(0 0)(300 90) entire=(0 0)(300 100) maxtab=72 fh=15
box[0] run wid=16 nrune=2 "aa"
box[1] brk wid=56 minwid=4 bc=9
box[2] run wid=18 nrune=2 "bb"
box[3] brk wid=54 minwid=4 bc=9
box[4] run wid=16 nrune=2 "cc"
box[5] brk wid=56 minwid=4 bc=9
box[6] run wid=18 nrune=2 "dd"
