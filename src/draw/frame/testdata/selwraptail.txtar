Differential frame test selwraptail (Go port vs C libframe).
-- script --
init 110 100
insert 0 "aaa bbb ccc ddd eee fff"
select 0,10,1 80,40,1 80,40,0
redraw
dump
-- output --
frame nbox=2 nchars=23 nlines=2 maxlines=6 lastlinefull=0 modified=0 p0=0 p1=23
  r=(0 0)(110 90) entire=(0 0)(110 100) maxtab=72 fh=15
box[0] run wid=105 nrune=14 "aaa bbb ccc dd"
box[1] run wid=56 nrune=9 "d eee fff"
