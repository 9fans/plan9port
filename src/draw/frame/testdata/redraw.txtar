Differential frame test redraw (Go port vs C libframe).
-- script --
init 200 100
insert 0 "hello world"
select 10,10,1 60,10,1 60,10,0
redraw
dump
-- output --
frame nbox=1 nchars=11 nlines=1 maxlines=6 lastlinefull=0 modified=0 p0=1 p1=8
  r=(0 0)(200 90) entire=(0 0)(200 100) maxtab=72 fh=15
box[0] run wid=78 nrune=11 "hello world"
