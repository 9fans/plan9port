Differential frame test unicode (Go port vs C libframe).
-- script --
init 200 100
insert 0 "café ©𝛂  B"
ptofchar 4
charofpt 30 10
dump
-- output --
ptofchar 4 = (29 0)
charofpt 30 10 = 4
frame nbox=1 nchars=10 nlines=1 maxlines=6 lastlinefull=0 modified=1 p0=10 p1=10
  r=(0 0)(200 90) entire=(0 0)(200 100) maxtab=72 fh=15
box[0] run wid=71 nrune=10 "café ©𝛂  B"
