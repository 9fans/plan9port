Differential frame test delmid (Go port vs C libframe).
-- script --
init 200 200
insert 0 "aa\nbb\ncc\ndd\nee"
delete 2 9
dump
-- output --
frame nbox=3 nchars=7 nlines=2 maxlines=13 lastlinefull=0 modified=1 p0=7 p1=7
  r=(0 0)(200 195) entire=(0 0)(200 200) maxtab=72 fh=15
box[0] run wid=34 nrune=4 "aadd"
box[1] brk wid=5000 minwid=0 bc=10
box[2] run wid=16 nrune=2 "ee"
