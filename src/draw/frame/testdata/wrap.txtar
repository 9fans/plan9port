Differential frame test wrap (Go port vs C libframe).
-- script --
init 120 100
insert 0 "the quick brown fox jumps"
dump
-- output --
frame nbox=2 nchars=25 nlines=2 maxlines=6 lastlinefull=0 modified=1 p0=25 p1=25
  r=(0 0)(120 90) entire=(0 0)(120 100) maxtab=72 fh=15
box[0] run wid=117 nrune=16 "the quick brown "
box[1] run wid=71 nrune=9 "fox jumps"
