Differential frame test ovffront (Go port vs C libframe).
-- script --
init 200 100
insert 0 "aaa\nbbb\nccc"
insert 0 "X\nY\nZ\n"
dump
-- output --
frame nbox=11 nchars=17 nlines=6 maxlines=6 lastlinefull=0 modified=1 p0=17 p1=17
  r=(0 0)(200 90) entire=(0 0)(200 100) maxtab=72 fh=15
box[0] run wid=9 nrune=1 "X"
box[1] brk wid=5000 minwid=0 bc=10
box[2] run wid=9 nrune=1 "Y"
box[3] brk wid=5000 minwid=0 bc=10
box[4] run wid=9 nrune=1 "Z"
box[5] brk wid=5000 minwid=0 bc=10
box[6] run wid=24 nrune=3 "aaa"
box[7] brk wid=5000 minwid=0 bc=10
box[8] run wid=27 nrune=3 "bbb"
box[9] brk wid=5000 minwid=0 bc=10
box[10] run wid=24 nrune=3 "ccc"
