Differential frame test basic (Go port vs C libframe).
-- script --
init 200 100
insert 0 "hello\tworld\nbye"
dump
-- output --
frame nbox=5 nchars=15 nlines=2 maxlines=6 lastlinefull=0 modified=1 p0=15 p1=15
  r=(0 0)(200 90) entire=(0 0)(200 100) maxtab=72 fh=15
box[0] run wid=34 nrune=5 "hello"
box[1] brk wid=38 minwid=4 bc=9
box[2] run wid=40 nrune=5 "world"
box[3] brk wid=5000 minwid=0 bc=10
box[4] run wid=25 nrune=3 "bye"
